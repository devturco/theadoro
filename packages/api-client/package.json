{
  "name": "@theadoro/api-client",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "generate": "kubb generate",
    "prebuild": "node ../../scripts/ensure-rollup-native.cjs",
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --watch --dts",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@kubb/cli": "latest",
    "@kubb/core": "latest",
    "@kubb/plugin-oas": "latest",
    "@kubb/plugin-ts": "latest",
    "@kubb/plugin-tanstack-query": "latest",
    "@kubb/plugin-zod": "latest",
    "@theadoro/config-typescript": "*",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.25.0",
    "zod": "^3.22.4"
  }
}
