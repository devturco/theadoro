# .dockerignore para THEADORO Gift Marketplace
# Otimiza o build excluindo arquivos desnecessários

# Dependências (serão instaladas no container)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs (serão gerados no container)
dist
build
.next
out

# Arquivos de desenvolvimento
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory usado por ferramentas como istanbul
coverage
*.lcov

# Arquivos de cache
.cache
.parcel-cache
.eslintcache

# Arquivos temporários
.tmp
.temp

# Arquivos do sistema operacional
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Arquivos do editor
.vscode
.idea
*.swp
*.swo
*~

# Git
.git
.gitignore

# Docker
Dockerfile*
docker-compose*
.dockerignore

# CI/CD
.github
.gitlab-ci.yml
.travis.yml
.circleci

# Documentação
README.md
CHANGELOG.md
LICENSE
*.md

# Arquivos de configuração de desenvolvimento
.editorconfig
.prettierrc*
.eslintrc*
# tsconfig.json - NECESSÁRIO para build
# vite.config.ts - NECESSÁRIO para build
tailwind.config.ts
postcss.config.js

# Arquivos de teste
__tests__
**/*.test.js
**/*.test.ts
**/*.test.tsx
**/*.spec.js
**/*.spec.ts
**/*.spec.tsx
jest.config.js
cypress
cypress.json

# Arquivos de backup
*.bak
*.backup
*.old

# Arquivos de desenvolvimento local
.trae
.vercel
.netlify

# Arquivos grandes desnecessários
*.tar
*.zip
*.gz
*.rar