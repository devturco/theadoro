# ─────────────────────────────────────────────────────────────
# THEADORO — variáveis de ambiente
# Copie para apps/web/.env.local (desenvolvimento)
# e mantenha .env.production com os valores de produção.
# NUNCA comite este arquivo preenchido.
# ─────────────────────────────────────────────────────────────

# Projeto Supabase (TheAdoro)
VITE_SUPABASE_URL=https://pfpbaepzvgovqheeqxlg.supabase.co
VITE_SUPABASE_PROJECT_ID=pfpbaepzvgovqheeqxlg

# Chave pública (anon/publishable). É pública por design — vai no bundle.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Metadados exibidos na interface
VITE_APP_NAME=THEADORO
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=production

# ─────────────────────────────────────────────────────────────
# SOMENTE SERVIDOR — nunca expor no frontend
# ─────────────────────────────────────────────────────────────

# Usada por scripts administrativos. Rotacione se circular.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# Secrets das Edge Functions (configure com `supabase secrets set`,
# NÃO neste arquivo):
#
#   UBER_CLIENT_ID / UBER_CLIENT_SECRET / UBER_CUSTOMER_ID
#   PAGARME_WEBHOOK_USER / PAGARME_WEBHOOK_PASSWORD
#   PAGARME_WEBHOOK_SECRET  (alternativa ao Basic Auth)
#
# As chaves do Pagar.me (pk_*/sk_*) ficam em Admin → Configurações.
# ─────────────────────────────────────────────────────────────